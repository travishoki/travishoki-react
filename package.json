{
	"name": "travis-hoki-react",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"start": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"test": "jest",
		"test:coverage": "jest --coverage",
		"test:watch": "jest --watch",
		"lint": "eslint --ext .js,.ts,.tsx src/",
		"lint:css": "stylelint \"src/**/*.scss\"",
		"lint:css:fix": "stylelint \"src/**/*.scss\" --fix",
		"format": "prettier --write \"src/**/*.{ts,tsx,scss}\"",
		"bounce": "rm -rf node_modules && yarn install",
		"ts-check": "npx tsc",
		"prepare": "husky install",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"stats": "node scripts/stats.mjs",
		"deadcode-find": "ts-prune",
		"deadcode-count": "yarn deadcode-find | wc -l"
	},
	"dependencies": {
		"@testing-library/jest-dom": "^6.5.0",
		"@testing-library/react": "^16.0.1",
		"@testing-library/user-event": "^13.5.0",
		"@types/jest": "^29.5.12",
		"@types/node": "^22.5.2",
		"@types/react": "^18.3.5",
		"@types/react-dom": "^18.3.0",
		"axios": "^1.7.7",
		"bootstrap": "^5.3.3",
		"classnames": "^2.5.1",
		"font-awesome": "^4.7.0",
		"motion": "^12.40.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-helmet-async": "^3.0.0",
		"react-router-dom": "^7.18.0",
		"typescript": "^5.5.4",
		"web-vitals": "^2.1.4"
	},
	"eslintConfig": {
		"extends": [
			"plugin:storybook/recommended"
		]
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"devDependencies": {
		"@storybook/addon-a11y": "^10.4.2",
		"@storybook/addon-docs": "^10.4.2",
		"@storybook/addon-onboarding": "^10.4.2",
		"@storybook/addon-vitest": "^10.4.2",
		"@storybook/react-vite": "^10.4.2",
		"@testing-library/dom": "^10.4.1",
		"@typescript-eslint/eslint-plugin": "^8.3.0",
		"@typescript-eslint/parser": "^8.3.0",
		"@vitejs/plugin-react": "^6.0.2",
		"@vitest/browser": "^4.1.8",
		"@vitest/browser-playwright": "^4.1.8",
		"console-table-printer": "^2.16.1",
		"eslint": "8",
		"eslint-config-prettier": "^9.1.0",
		"eslint-import-resolver-alias": "^1.1.2",
		"eslint-import-resolver-typescript": "^3.6.3",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-no-only-tests": "^3.3.0",
		"eslint-plugin-perfectionist": "^5.9.1",
		"eslint-plugin-prettier": "^5.2.1",
		"eslint-plugin-promise": "^7.1.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-sort-destructure-keys": "^2.0.0",
		"eslint-plugin-storybook": "^10.4.2",
		"eslint-plugin-typescript-sort-keys": "^3.2.0",
		"husky": "^9.1.5",
		"inquirer": "^14.0.2",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"lint-staged": "^15.2.10",
		"mockdate": "^3.0.5",
		"msw": "^2.14.6",
		"msw-storybook-addon": "^2.0.7",
		"playwright": "^1.60.0",
		"postcss-scss": "^4.0.9",
		"prettier": "^3.3.3",
		"prop-types": "^15.8.1",
		"sass": "^1.89.0",
		"storybook": "^10.4.2",
		"stylelint": "^17.12.0",
		"stylelint-order": "^8.1.1",
		"ts-jest": "^29.2.5",
		"ts-node": "^10.9.2",
		"ts-prune": "^0.10.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"lint-staged": {
		"*.{js,ts,tsx}": [
			"eslint --cache --fix"
		],
		"*.{css,scss}": [
			"stylelint --fix",
			"prettier --write"
		]
	},
	"msw": {
		"workerDirectory": [
			"public"
		]
	}
}
