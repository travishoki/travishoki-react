{
	"name": "travis-hoki-react",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"start": "vite",
		"build": "yarn resume:sync && vite build",
		"resume:sync": "bash job-applications/build/sync-public.sh",
		"preview": "vite preview",
		"test": "jest",
		"test:coverage": "jest --coverage",
		"test:watch": "jest --watch",
		"lint": "eslint \"src/**/*.{js,ts,tsx}\"",
		"lint:css": "stylelint \"src/**/*.scss\"",
		"lint:css:fix": "stylelint \"src/**/*.scss\" --fix",
		"format": "prettier --write \"src/**/*.{ts,tsx,scss}\"",
		"bounce": "rm -rf node_modules && yarn install",
		"ts-check": "npx tsc",
		"prepare": "husky install",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"stats": "node scripts/stats.mjs",
		"deadcode-find": "ts-prune",
		"deadcode-count": "yarn deadcode-find | wc -l"
	},
	"dependencies": {
		"@fortawesome/fontawesome-svg-core": "^7.2.0",
		"@fortawesome/free-brands-svg-icons": "^7.2.0",
		"@fortawesome/free-solid-svg-icons": "^7.2.0",
		"@fortawesome/react-fontawesome": "^3.3.1",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/react": "^16.0.1",
		"@testing-library/user-event": "^14.0.0",
		"@types/jest": "^30.0.0",
		"@types/node": "^22.5.2",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"axios": "^1.7.7",
		"bootstrap": "^5.3.3",
		"classnames": "^2.5.1",
		"motion": "^12.40.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-helmet-async": "^3.0.0",
		"react-router-dom": "^7.18.0",
		"typescript": "^6.0.3",
		"web-vitals": "^6.0.0"
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.7",
		"@eslint/js": "^9.39.5",
		"@storybook/addon-a11y": "^10.4.2",
		"@storybook/addon-docs": "^10.4.2",
		"@storybook/addon-onboarding": "^10.4.2",
		"@storybook/addon-vitest": "^10.4.2",
		"@storybook/react-vite": "^10.4.2",
		"@testing-library/dom": "^10.4.1",
		"@typescript-eslint/eslint-plugin": "^8.3.0",
		"@typescript-eslint/parser": "^8.3.0",
		"@vitejs/plugin-react": "^6.0.2",
		"@vitest/browser": "^4.1.8",
		"@vitest/browser-playwright": "^4.1.8",
		"console-table-printer": "^2.16.1",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.0.0",
		"eslint-import-resolver-alias": "^1.1.2",
		"eslint-import-resolver-typescript": "^4.0.0",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-no-only-tests": "^3.3.0",
		"eslint-plugin-perfectionist": "^5.9.1",
		"eslint-plugin-prettier": "^5.2.1",
		"eslint-plugin-promise": "^7.1.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-sort-destructure-keys": "^3.0.0",
		"eslint-plugin-storybook": "^10.4.2",
		"eslint-plugin-typescript-sort-keys": "^3.2.0",
		"husky": "^9.1.5",
		"inquirer": "^14.0.2",
		"jest": "^30.0.0",
		"jest-environment-jsdom": "^30.0.0",
		"lint-staged": "^15.2.10",
		"mockdate": "^3.0.5",
		"msw": "^2.14.6",
		"msw-storybook-addon": "^3.0.0",
		"playwright": "^1.60.0",
		"postcss-scss": "^4.0.9",
		"prettier": "^3.3.3",
		"prop-types": "^15.8.1",
		"sass": "^1.89.0",
		"storybook": "^10.4.2",
		"stylelint": "^17.12.0",
		"stylelint-order": "^8.1.1",
		"ts-jest": "^29.2.5",
		"ts-node": "^10.9.2",
		"ts-prune": "^0.10.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"lint-staged": {
		"*.{js,ts,tsx}": [
			"eslint --cache --fix"
		],
		"*.{css,scss}": [
			"stylelint --fix",
			"prettier --write"
		]
	},
	"msw": {
		"workerDirectory": [
			"public"
		]
	}
}
